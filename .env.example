# ---- Claude ----
ANTHROPIC_API_KEY=
# 解析 / 造结构 / 上下文化 / vision 用便宜模型；检索回答用 opus
KB_MODEL_PARSE=claude-haiku-4-5
KB_MODEL_CONTEXT=claude-haiku-4-5
KB_MODEL_VISION=claude-haiku-4-5
KB_MODEL_ANSWER=claude-opus-4-8

# ---- Postgres + pgvector ----
DATABASE_URL=postgres://kb:kb@localhost:5432/kbstudio

# ---- Embedding（OpenAI 兼容端点，默认 BGE-M3）----
# 例：本地 Ollama http://localhost:11434/v1 ；或 SiliconFlow https://api.siliconflow.cn/v1
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---- 代理（本机 Clash Verge 在 7897）----
# 如果直连 Anthropic / embedding 需要走代理，按需打开：
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# 注册邮箱验证码发信（SMTP）。不填则验证码打到服务端 console（dev 兜底）。
# 示例（163邮箱）：SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_SECURE=true，SMTP_PASS 填邮箱「客户端授权密码」非登录密码
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
