# ---- Claude ----
ANTHROPIC_API_KEY=
# 解析 / 造结构 / 上下文化 / vision 用便宜模型；检索回答用 opus
KB_MODEL_PARSE=claude-haiku-4-5
KB_MODEL_CONTEXT=claude-haiku-4-5
KB_MODEL_VISION=claude-haiku-4-5
KB_MODEL_ANSWER=claude-opus-4-8
# agentic 工具循环（LlmClient.runTools()）专用模型，独立于 KB_MODEL_ANSWER——后者对话层两个后端
# （302 的 LlmClient / 方舟的 ArkLlmClient）共用，实际部署里可能被设成豆包模型名；runTools() 打的是
# 302 的 Anthropic /v1/messages 协议端点，不能拿豆包模型名去调。必须填一个支持 tool use 的 Anthropic 模型。
KB_MODEL_AGENT=claude-opus-4-8

# ---- Postgres + pgvector ----
DATABASE_URL=postgres://kb:kb@localhost:5432/kbstudio

# ---- Embedding（OpenAI 兼容端点，默认 BGE-M3）----
# 例：本地 Ollama http://localhost:11434/v1 ；或 SiliconFlow https://api.siliconflow.cn/v1
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# ---- 代理（本机 Clash Verge 在 7897）----
# 如果直连 Anthropic / embedding 需要走代理，按需打开：
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# 注册邮箱验证码发信（SMTP）。不填则验证码打到服务端 console（dev 兜底）。
# 示例（163邮箱）：SMTP_HOST=smtp.163.com SMTP_PORT=465 SMTP_SECURE=true，SMTP_PASS 填邮箱「客户端授权密码」非登录密码
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- collector 对接（材料收集表单 → /api/ingest）----
# collector 后端调 /api/ingest 用的服务密钥（Bearer），两边必须一致。生成：openssl rand -base64 32
COLLECTOR_SERVICE_SECRET=
# collector 表单的对外基址；「复制收集链接」据此拼成 <base>/form?ref=<token>。部署后填实际域名。
NEXT_PUBLIC_COLLECTOR_BASE_URL=

# ---- 管理后台（/admin）----
# 默认 admin/admin；生产务必改密码，并设置随机 ADMIN_SESSION_SECRET（openssl rand -base64 32）。
# 注意：web 运行时读 root .env（apps/web/.env.local → root .env 软链），本地这三项也要写进实际 .env。
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_SESSION_SECRET=
