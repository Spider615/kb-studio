{
  "name": "kb-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspace @kb/web",
    "parse-one": "tsx apps/worker/src/cli/parse-one.ts",
    "chunk-demo": "tsx apps/worker/src/cli/chunk-demo.ts",
    "structure-demo": "tsx apps/worker/src/cli/structure-demo.ts",
    "enrich-demo": "tsx apps/worker/src/cli/enrich-demo.ts",
    "ingest-demo": "tsx apps/worker/src/cli/ingest-demo.ts",
    "search-demo": "tsx apps/worker/src/cli/search-demo.ts",
    "scoped-search-demo": "tsx apps/worker/src/cli/scoped-search-demo.ts",
    "groups-demo": "tsx apps/worker/src/cli/groups-demo.ts",
    "answer-demo": "tsx apps/worker/src/cli/answer-demo.ts",
    "chat-demo": "tsx apps/worker/src/cli/chat-demo.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
